<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:scrollbars="vertical">

        <!-- Naslov -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/placeImage"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/name"
                        android:layout_width="275dp"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingTop="8dp"
                        android:paddingStart="8dp"
                        android:textColor="#0EAF0E"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/averageRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textColor="@color/black"
                        android:textSize="26sp" />
                </LinearLayout>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:textSize="19sp" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:layout_marginTop="25px"
                    android:textSize="16sp"
                    tools:ignore="RtlSymmetry" />

                <LinearLayout
                    android:layout_width="347dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25px"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/minGuest"
                        android:layout_width="290dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textSize="16sp" />

                </LinearLayout>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/facilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25px"
                    android:paddingStart="8dp"
                    android:text="Facilities"
                    android:textColor="#0EAF0E"
                    android:textSize="18sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="195dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="Wifi"
                        android:textSize="16sp"
                        tools:ignore="RtlSymmetry" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/wifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textSize="16sp"
                        tools:ignore="RtlSymmetry" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="195dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="Kitchen"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/kitchen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="195dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="AC"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/airConditioner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="195dp"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:text="Parking"
                        android:textSize="16sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/parking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="8dp"
                        android:textSize="16sp" />
                </LinearLayout>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/eco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25px"
                    android:paddingStart="8dp"
                    android:text="Eco-Friendly Amenities"
                    android:textColor="#0EAF0E"
                    android:textSize="18sp" />
                <LinearLayout
                    android:id="@+id/ecoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="5dp">
                    <!-- This will dynamically populate with eco-friendly amenities -->
                </LinearLayout>



            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/pric"
                android:layout_width="313dp"
                android:layout_height="wrap_content"
                android:paddingStart="9dp"
                android:text="Total price:"
                android:textColor="@color/black"
                android:textSize="23sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/price"
                android:layout_width="95dp"
                android:layout_height="wrap_content"
                android:paddingStart="2dp"
                android:textColor="@color/black"
                android:textSize="23sp" />


        </LinearLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/reserve"
            android:layout_width="500px"
            android:layout_height="wrap_content"
            style="@style/Button"
            android:textSize="17dp"
            app:backgroundTint="#303633"
            android:layout_gravity="center_horizontal"
            android:text="Reserve" />
    </LinearLayout>
</ScrollView>
